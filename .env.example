# ── Site (canonical URLs for SEO / Open Graph) ──
NEXT_PUBLIC_SITE_URL=https://nexim.world

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Generative AI (Gemini) ──
# Server-only — used in /api/analyze route handler (Google AI Studio key; not Vertex).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional aliases (first non-empty wins):
# GEMINI_API_KEY=
# GOOGLE_AI_KEY=
# Prefer IPv4 for outbound Gemini (helps some Node 18+ / DNS setups). Set "false" to disable:
# NEXIM_GEMINI_DNS_IPV4_FIRST=true

# Supabase Auth: add BOTH redirect URLs if you use two local ports:
#   http://localhost:3000/api/auth/callback
#   http://localhost:3001/api/auth/callback

# ── Stripe (optional) ──
STRIPE_WEBHOOK_SECRET=whsec_…

# ── HMAC secret for payment tokens ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXIM_TOKEN_SECRET=

# ── Resend (results email) ──
RESEND_API_KEY=
# Verified sender, e.g. Nexim <noreply@nexim.world>
RESEND_FROM_EMAIL=
